<?xml version="1.0" encoding="utf-8"?>
<!-- MyDoc is offline-first. The only network traffic is the GitHub update check and APK
     download over HTTPS; cleartext is refused everywhere. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
