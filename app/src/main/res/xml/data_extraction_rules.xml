<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude user preferences: contains sensitive biometric app lock state and device-specific configs -->
        <exclude domain="sharedpref" path="mydoc_settings.xml" />

        <!-- Exclude updater state: contains update check timestamps and dismissed release tags -->
        <exclude domain="sharedpref" path="mydoc_updater.xml" />

        <!-- Exclude cache: temporary render caches, updates, and shared files should not persist in cloud backup -->
        <exclude domain="root" path="cache" />

        <!-- Exclude hardware-backed encrypted signature file: key in Android Keystore cannot be migrated -->
        <exclude domain="file" path="user_signature.enc" />

        <!-- Exclude trash and cached offline documents from cloud backup -->
        <exclude domain="file" path=".trash" />
        <exclude domain="external" path=".trash" />
        <exclude domain="external" path="Android/data/com.abhisheksati.mydoc/files/.trash" />
        <exclude domain="file" path="saved_docs" />
        <exclude domain="external" path="Android/data/com.abhisheksati.mydoc/files/saved_docs" />
    </cloud-backup>

    <device-transfer>
        <!-- Exclude user preferences: contains sensitive biometric app lock state and device-specific configs -->
        <exclude domain="sharedpref" path="mydoc_settings.xml" />

        <!-- Exclude updater state: contains update check timestamps and dismissed release tags -->
        <exclude domain="sharedpref" path="mydoc_updater.xml" />

        <!-- Exclude cache: temporary render caches, updates, and shared files should not persist during device transfer -->
        <exclude domain="root" path="cache" />

        <!-- Exclude hardware-backed encrypted signature file: key in Android Keystore cannot be migrated -->
        <exclude domain="file" path="user_signature.enc" />

        <!-- Exclude trash and cached offline documents from device transfer -->
        <exclude domain="file" path=".trash" />
        <exclude domain="external" path=".trash" />
        <exclude domain="external" path="Android/data/com.abhisheksati.mydoc/files/.trash" />
        <exclude domain="file" path="saved_docs" />
        <exclude domain="external" path="Android/data/com.abhisheksati.mydoc/files/saved_docs" />
    </device-transfer>
</data-extraction-rules>
