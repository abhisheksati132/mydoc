<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ draws the starting window from the platform attributes before any
         library code runs, so the brand mark has to be declared here too. -->
    <style name="Theme.MyDoc.Splash" parent="Theme.MyDoc">
        <item name="android:windowSplashScreenBackground">@color/app_window_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/app_splash_icon</item>
        <item name="android:windowSplashScreenAnimationDuration">600</item>
        <item name="postSplashScreenTheme">@style/Theme.MyDoc</item>
    </style>
</resources>
